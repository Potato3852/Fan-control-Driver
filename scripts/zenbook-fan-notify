#!/usr/bin/env bash

if [ $# -eq 0 ]; then
    echo "Usage: zenbook-fan-notify <get|set|toggle> [mode]"
    exit 1
fi

RESPONSE=$(fan-cli "$@")
EXIT_CODE=$?

echo "$RESPONSE"

if [ $EXIT_CODE -eq 0 ] && command -v notify-send &> /dev/null; then
    notify-send -u low -i fan -t 2000 "Thermal Profile" "$RESPONSE"
fi